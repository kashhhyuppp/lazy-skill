# ---------------------------------------------------------------
# Lazy Skill — copy to .env.local and fill in. Never commit .env*.
# ---------------------------------------------------------------

# Public origin. Used for metadataBase, OG tags, and pairing callbacks.
# Never hardcode localhost anywhere else in the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Skills registry (Phase 2) ---------------------------------
# Optional override; defaults to https://skills.sh/api/v1
SKILLS_API_BASE_URL=

# NOT set by hand. skills.sh authenticates with a Vercel OIDC token, which
# Vercel injects at runtime in production and `vercel env pull` writes into
# .env.local for development:
#
#   pnpm dlx vercel link
#   pnpm dlx vercel env pull
#
# Enable it first under Vercel > Project > Settings > OIDC Federation.
# When this variable is absent the app runs on the local sample provider.
# VERCEL_OIDC_TOKEN=

# --- Supabase (Phase 3) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Must never be referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Device pairing (Phase 5/6) --------------------------------
# Peppers the HMAC used to store pairing codes and device tokens, so a
# database leak yields nothing replayable. Must be 32+ characters.
# Generate one with:  openssl rand -base64 48
PAIRING_SECRET=
